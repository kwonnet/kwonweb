NEXT_PUBLIC_APP_URL=http://localhost:3000

CLOUDFLARE_ZONE_ID=""
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_ACCOUNT_API_TOKEN=""
CLOUDFLARE_ACCESS_KEY=""
CLOUDFLARE_SECRET_KEY=""
CLOUDFLARE_S3_API_ENDPOINT=""
CLOUDFLARE_PUBLIC_MEDIA_URL=https://media.kwonnet.com
# Required R2 bucket name; separate from the account-level S3 endpoint.
CLOUDFLARE_BUCKET_NAME="kwonnet"

# Stream: CLOUDFLARE_ACCOUNT_API_TOKEN must have Account > Stream > Edit.
# Maximum accepted video duration (seconds); uploads are capped at 1 GiB.
CLOUDFLARE_STREAM_MAX_DURATION_SECONDS=600

# Google OAuth: configure these as server-only runtime secrets.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Server-only metadata bridge: same independent random >=32-character secret as kwonserver.
AUTH_TELEMETRY_SHARED_SECRET=
# Optional single-address IP header. Enable ONLY if trusted ingress overwrites it
# and direct origin bypass is blocked; otherwise browser IP/location stays null.
AUTH_TRUSTED_WEB_IP_HEADER=cf-connecting-ip

# Optional search-engine ownership verification tokens (not OAuth credentials).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Match the API registration flag; unset/false hides new account registration.
NEXT_PUBLIC_REGISTRATION_ENABLED=false
